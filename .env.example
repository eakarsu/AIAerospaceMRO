NODE_ENV=development
BACKEND_PORT=4000
FRONTEND_PORT=3000
DATABASE_URL=postgresql://app_user:replace-me@localhost:5432/app_db
DB_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000
MRO_ERP_API_URL=
TECH_PUBS_API_URL=
PARTS_TRACE_API_URL=
SENSOR_FEED_API_URL=
